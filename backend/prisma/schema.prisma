generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SHIPPER
  CARRIER
  ADMIN
}

enum ShipmentStatus {
  PENDING
  MATCHING
  NEGOTIATING
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum DealStatus {
  PROPOSED
  COUNTERED
  ACCEPTED
  REJECTED
}

enum NegotiationRoundStatus {
  PENDING
  RESPONDED
  WAITING_FOR_COUNTER
  COMPLETED
}

enum AssistantSessionStatus {
  ACTIVE
  PENDING_REVIEW
  SUBMITTED
  COMPLETED
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  password     String
  phoneNumber  String?
  role         Role       @default(SHIPPER)
  company      String?
  createdAt    DateTime   @default(now())
  shipments    Shipment[]
  trucks       Truck[]
  deals        Deal[]     @relation("DealOwner")
  assistantSessions OrderAssistantSession[]
}

model Shipment {
  id                        String         @id @default(cuid())
  ownerId                   String
  owner                     User           @relation(fields: [ownerId], references: [id])
  cargoType                 String
  category                  String
  weightKg                  Int
  requiredTempMin           Int
  requiredTempMax           Int
  pickup                    String
  dropoff                   String
  pickupLat                 Float
  pickupLng                 Float
  dropoffLat                Float
  dropoffLng                Float
  deliveryTime              DateTime
  proposedPrice             Int
  notes                     String?
  strongSmell               Boolean        @default(false)
  fragile                   Boolean        @default(false)
  frozenRequired            Boolean        @default(false)
  specialTemperature        Boolean        @default(false)
  allowCombine              Boolean        @default(true)
  compatibilityNote         String?
  status                    ShipmentStatus @default(PENDING)
  createdAt                 DateTime       @default(now())
  matches                   Match[]
  deals                     Deal[]
}

model Truck {
  id               String   @id @default(cuid())
  ownerId          String
  owner            User     @relation(fields: [ownerId], references: [id])
  type             String
  plateNumber      String   @unique
  maxCapacityKg    Int
  remainingKg      Int
  refrigerated     Boolean  @default(false)
  tempMin          Int?
  tempMax          Int?
  currentRoute     String
  currentLat       Float
  currentLng       Float
  eta              DateTime
  active           Boolean  @default(true)
  currentTemp      Float?
  matches          Match[]
  deals            Deal[]
  trackingEvents   TrackingEvent[]
}

model Match {
  id                 String   @id @default(cuid())
  shipmentId         String
  shipment           Shipment @relation(fields: [shipmentId], references: [id])
  truckId            String
  truck              Truck    @relation(fields: [truckId], references: [id])
  matchingScore      Int
  compatibilityScore Int
  distanceScore      Int
  capacityScore      Int
  timeScore          Int
  estimatedSavings   Int
  warnings           String[]
  createdAt          DateTime @default(now())
}

model Deal {
  id                      String                @id @default(cuid())
  shipmentId              String
  shipment                Shipment              @relation(fields: [shipmentId], references: [id])
  truckId                 String?
  truck                   Truck?                @relation(fields: [truckId], references: [id])
  ownerId                 String
  owner                   User                  @relation("DealOwner", fields: [ownerId], references: [id])
  status                  DealStatus            @default(PROPOSED)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  negotiationRounds       NegotiationRound[]
  finalPrice              Int?
}

model NegotiationRound {
  id                String                    @id @default(cuid())
  dealId            String
  deal              Deal                      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  roundNumber       Int
  proposedPrice     Int
  respondedPrice    Int?
  status            NegotiationRoundStatus    @default(PENDING)
  proposedBy        String                    
  respondedBy       String?                   
  message           String?
  responseMessage   String?
  createdAt         DateTime                  @default(now())
  respondedAt       DateTime?
  
  @@index([dealId])
}

model TrackingEvent {
  id          String   @id @default(cuid())
  truckId     String
  truck       Truck    @relation(fields: [truckId], references: [id])
  lat         Float
  lng         Float
  temperature Float
  etaMinutes  Int
  alert       String?
  createdAt   DateTime @default(now())
}

model OrderAssistantSession {
  id                    String                        @id @default(cuid())
  userId                String
  user                  User                          @relation(fields: [userId], references: [id])
  status                AssistantSessionStatus        @default(ACTIVE)
  copilotIntent         String?
  copilotStatus         String                        @default("COLLECTING_DATA")
  copilotApi            String?
  copilotMethod         String                        @default("POST")
  copilotData           Json?
  copilotMissingFields  String[]                      @default([])
  copilotValidationErrors String[]                    @default([])
  copilotConfirmationMessage String?
  copilotApproved       Boolean                       @default(false)
  copilotSubmittedEntityType String?
  copilotSubmittedEntityId   String?
  copilotSubmittedAt    DateTime?
  
  // Order data being collected
  cargoType             String?
  category              String?
  weightKg              Int?
  requiredTempMin       Int?
  requiredTempMax       Int?
  pickup                String?
  dropoff               String?
  pickupLat             Float?
  pickupLng             Float?
  dropoffLat            Float?
  dropoffLng            Float?
  deliveryTime          DateTime?
  proposedPrice         Int?
  notes                 String?
  strongSmell           Boolean?
  fragile               Boolean?
  frozenRequired        Boolean?
  specialTemperature    Boolean?
  allowCombine          Boolean?
  compatibilityNote     String?
  
  // Completion tracking
  completenessScore     Float                         @default(0)
  missingFields         String[]                      @default([])
  conversationHistory   AssistantMessage[]
  
  // Generated form
  submittedShipmentId   String?
  submittedAt           DateTime?
  
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  
  @@index([userId, status])
}

model AssistantMessage {
  id                      String                      @id @default(cuid())
  sessionId               String
  session                 OrderAssistantSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role                    String                      
  content                 String
  suggestedFields         String[]                    @default([])
  createdAt               DateTime                    @default(now())
  
  @@index([sessionId])
}
